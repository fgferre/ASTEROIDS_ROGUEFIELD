{
  "name": "asteroids_roguefield",
  "version": "0.8.2",
  "description": "Roguelike game inspired by Asteroids mechanics",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/pinned-node.mjs scripts/vitest-group.mjs run",
    "test:watch": "node scripts/pinned-node.mjs node_modules/vitest/vitest.mjs watch",
    "test:ui": "node scripts/pinned-node.mjs node_modules/vitest/vitest.mjs --ui",
    "test:coverage": "node scripts/pinned-node.mjs scripts/vitest-group.mjs run --coverage",
    "test:tocados": "node scripts/pinned-node.mjs scripts/tocados.mjs",
    "gate": "npm run lint && npm run test:tocados",
    "done": "node scripts/done.mjs",
    "test:core": "node scripts/pinned-node.mjs scripts/vitest-group.mjs run tests/core",
    "test:modules": "node scripts/pinned-node.mjs scripts/vitest-group.mjs run tests/modules",
    "test:utils": "node scripts/pinned-node.mjs scripts/vitest-group.mjs run tests/utils",
    "test:services": "node scripts/pinned-node.mjs scripts/vitest-group.mjs run tests/services",
    "test:integration": "node scripts/pinned-node.mjs scripts/vitest-group.mjs run tests/integration",
    "test:balance": "node scripts/pinned-node.mjs scripts/vitest-group.mjs run tests/balance",
    "test:visual": "node scripts/pinned-node.mjs scripts/vitest-group.mjs run tests/visual",
    "test:physics": "node scripts/pinned-node.mjs scripts/vitest-group.mjs run tests/physics",
    "playtest": "node scripts/pinned-node.mjs scripts/playtest.mjs",
    "capture": "node scripts/capture.mjs",
    "cartao": "node scripts/cartao.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "3.2.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "nipplejs": "^1.0.4",
    "three": "0.187.0"
  }
}

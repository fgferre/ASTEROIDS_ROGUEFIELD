{
  "name": "asteroids_roguefield",
  "version": "1.0.0",
  "description": "Roguelike game inspired by Asteroids mechanics",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:tocados": "node scripts/tocados.mjs",
    "gate": "npm run lint && npm run test:tocados",
    "done": "npm run lint && npm run format:check && npm test && npm run build",
    "test:core": "vitest run tests/core",
    "test:modules": "vitest run tests/modules",
    "test:utils": "vitest run tests/utils",
    "test:services": "vitest run tests/services",
    "test:integration": "vitest run tests/integration",
    "test:balance": "vitest run tests/balance",
    "test:visual": "vitest run tests/visual",
    "test:physics": "vitest run tests/physics",
    "test:visual-enemies": "echo 'Open http://localhost:5173/scripts/visual-enemy-rendering-test.html in browser' && npm run dev",
    "stress": "node scripts/run-stress-checks.mjs",
    "analyze:deps": "node scripts/analyze-dependencies.js && node scripts/generate-mermaid-graph.js",
    "analyze:deps:watch": "nodemon --watch src --exec npm run analyze:deps",
    "validate:deps": "node scripts/analyze-dependencies.js --validate-only",
    "test:benchmark": "node scripts/benchmark-tests.js",
    "test:validate-optimizations": "node scripts/validate-test-optimizations.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "nodemon": "^3.1.10",
    "prettier": "3.2.5",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
